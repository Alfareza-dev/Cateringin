generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  CUSTOMER
  KITCHEN
  DRIVER
}

enum DeliveryMethod {
  DELIVERY
  PICKUP
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SkipStatus {
  PENDING
  APPROVED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_KITCHEN
  ON_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  fullName      String
  phone         String
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  subscriptions Subscription[]
  orders        Order[]
  reviews       Review[]
}

model Address {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  label         String
  fullAddress   String
  note          String?
  latitude      Float
  longitude     Float
  isPrimary     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  orders        Order[]
}

model DeliverySlot {
  id            String         @id @default(uuid())
  name          String
  startTime     String
  endTime       String
  maxCapacity   Int            @default(50)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]
  orders        Order[]
}

model Menu {
  id          String              @id @default(uuid())
  name        String
  description String              @db.Text
  imageUrl    String?
  price       Decimal             @db.Decimal(10, 2)
  calories    Int?
  dietaryTags Json
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  schedules   DailyMenuSchedule[]
  orderItems  OrderItem[]
}

model DailyMenuSchedule {
  id        String   @id @default(uuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id])
  date      DateTime @db.Date
  createdAt DateTime @default(now())
}

model Subscription {
  id             String             @id @default(uuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])
  durationDays   Int
  startDate      DateTime           @db.Date
  endDate        DateTime           @db.Date
  remainingDays  Int
  status         SubscriptionStatus @default(ACTIVE)
  deliveryMethod DeliveryMethod     @default(DELIVERY)
  addressId      String?
  address        Address?           @relation(fields: [addressId], references: [id])
  slotId         String
  slot           DeliverySlot       @relation(fields: [slotId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  skips          SubscriptionSkip[]
  orders         Order[]
}

model SubscriptionSkip {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  skipDate       DateTime     @db.Date
  status         SkipStatus   @default(PENDING)
  reason         String?
  createdAt      DateTime     @default(now())
}

model Order {
  id               String         @id @default(uuid())
  orderNumber      String         @unique
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  subscriptionId   String?
  subscription     Subscription?  @relation(fields: [subscriptionId], references: [id])
  deliveryMethod   DeliveryMethod
  addressId        String?
  address          Address?       @relation(fields: [addressId], references: [id])
  slotId           String
  slot             DeliverySlot   @relation(fields: [slotId], references: [id])
  status           OrderStatus    @default(PENDING_PAYMENT)
  subtotal         Decimal        @db.Decimal(10, 2)
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  totalPrice       Decimal        @db.Decimal(10, 2)
  notes            String?
  estimatedArrival DateTime?
  proofOfDelivery  String?
  pickupPin        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            OrderItem[]
  payment          Payment?
  review           Review?
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
  menuId       String
  menu         Menu    @relation(fields: [menuId], references: [id])
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  specialNotes String?
}

model Payment {
  id                 String        @id @default(uuid())
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id])
  louvinInvoiceId    String?       @unique
  louvinPaymentUrl   String?
  amount             Decimal       @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  rawCallbackPayload Json?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Review {
  id        String   @id @default(uuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  photoUrl  String?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id               Int      @id @default(1)
  kitchenLatitude  Float?
  kitchenLongitude Float?
  maxRadiusKm      Float?
  baseDeliveryFee  Decimal? @db.Decimal(10, 2)
  feePerKm         Decimal? @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt
}
